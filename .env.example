# Copy this file to .env before running Docker or Prisma commands.
# Use a long unique value outside local development.
POSTGRES_DB=bostan
POSTGRES_USER=bostan_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Used by Prisma and, later, the application server.
DATABASE_URL="postgresql://bostan_app:change-this-local-password@localhost:5432/bostan?schema=public"


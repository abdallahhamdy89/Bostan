generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OWNER
}

enum ContactType {
  PHONE
  WHATSAPP
  EMAIL
  ADDRESS
}

enum ResidenceStatus {
  RESIDENT
  NON_RESIDENT
  UNKNOWN
}

enum FeeScope {
  BUILDING
  FLOOR
  APARTMENT
}

enum ChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH_MANUAL
  BANK_TRANSFER
  CARD
  WALLET
  ONLINE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole
  ownerId      String?  @unique
  owner        Owner?   @relation(fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Building {
  id               String          @id @default(cuid())
  name             String
  address          String?
  locationNotes    String?
  floors           Int
  notes            String?
  collectorName    String?
  collectorContact String?
  apartments       Apartment[]
  feeAssignments   FeeAssignment[]
  importBatches    ImportBatch[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Apartment {
  id             String           @id @default(cuid())
  buildingId     String
  number         String
  floor          Int
  areaM2         Decimal?         @db.Decimal(8, 2)
  currentOwnerId String?
  building       Building         @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  currentOwner   Owner?           @relation("CurrentOwner", fields: [currentOwnerId], references: [id], onDelete: SetNull)
  ownerships     Ownership[]
  feeAssignments FeeAssignment[]
  charges        FeeCharge[]
  payments       Payment[]
  specialFees    SpecialFee[]
  @@unique([buildingId, number])
  @@index([buildingId, floor])
}

model Owner {
  id              String          @id @default(cuid())
  fullName        String
  nationalId      String?         @unique
  residenceStatus ResidenceStatus @default(UNKNOWN)
  notes           String?
  contacts        OwnerContact[]
  user            User?
  currentApartments Apartment[]   @relation("CurrentOwner")
  ownerships      Ownership[]
  payments        Payment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([fullName])
}

model OwnerContact {
  id        String      @id @default(cuid())
  ownerId   String
  type      ContactType
  value     String
  isPrimary Boolean     @default(false)
  owner     Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, type])
}

// Exactly one active ownership row per apartment is enforced in application logic.
// Payments preserve their ownerId so a sale never rewrites historical payment data.
model Ownership {
  id          String    @id @default(cuid())
  apartmentId String
  ownerId     String
  startsOn    DateTime  @db.Date
  endsOn      DateTime? @db.Date
  notes       String?
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  @@index([apartmentId, startsOn])
  @@index([ownerId])
}

model FeeType {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  assignments FeeAssignment[]
  charges     FeeCharge[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// One definition can be applied to every apartment in a building, one floor, or one apartment.
model FeeAssignment {
  id          String    @id @default(cuid())
  feeTypeId   String
  buildingId  String
  scope       FeeScope
  floor       Int?
  apartmentId String?
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime? @db.Date
  periodLabel String?
  notes       String?
  feeType     FeeType   @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  charges     FeeCharge[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([buildingId, scope, floor])
  @@index([apartmentId])
}

// A charge is the actual amount owed by one apartment and forms its ledger.
model FeeCharge {
  id              String       @id @default(cuid())
  apartmentId     String
  feeTypeId       String
  feeAssignmentId String?
  amount          Decimal      @db.Decimal(12, 2)
  dueDate         DateTime?    @db.Date
  periodLabel     String?
  status          ChargeStatus @default(OPEN)
  notes           String?
  apartment       Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  feeType         FeeType      @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  feeAssignment   FeeAssignment? @relation(fields: [feeAssignmentId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([apartmentId, dueDate])
  @@index([status])
}

model PaymentType {
  id        String    @id @default(cuid())
  name      String    @unique
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  apartmentId   String
  ownerId       String
  paymentTypeId String?
  amount        Decimal       @db.Decimal(12, 2)
  paidOn        DateTime      @db.Date
  method        PaymentMethod @default(CASH_MANUAL)
  receiptNumber String        @unique
  notes         String?
  apartment     Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  owner         Owner         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  paymentType   PaymentType?  @relation(fields: [paymentTypeId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]
  receipt       Receipt?
  createdAt     DateTime      @default(now())
  @@index([apartmentId, paidOn])
  @@index([ownerId, paidOn])
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  feeChargeId String
  amount      Decimal   @db.Decimal(12, 2)
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  feeCharge   FeeCharge @relation(fields: [feeChargeId], references: [id], onDelete: Restrict)
  @@unique([paymentId, feeChargeId])
  @@index([feeChargeId])
}

model Receipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  pdfPath       String?
  issuedAt      DateTime @default(now())
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model SpecialFeeType {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  cellMapping String       // JSON: {collectionAmount, validationAmount, receiptCell}
  specialFees SpecialFee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SpecialFee {
  id               String          @id @default(cuid())
  apartmentId      String
  specialFeeTypeId String
  collectionAmount Decimal         @db.Decimal(12, 2)
  collectedAmount  Decimal?        @db.Decimal(12, 2)
  receiptNumber    String?
  status           ChargeStatus    @default(OPEN)
  paidDate         DateTime?
  notes            String?
  apartment        Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  specialFeeType   SpecialFeeType  @relation(fields: [specialFeeTypeId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([apartmentId, specialFeeTypeId])
  @@index([apartmentId])
}

model ImportBatch {
  id          String       @id @default(cuid())
  buildingId  String?
  fileName    String
  status      ImportStatus @default(PENDING)
  errorLog    String?
  importedAt  DateTime?
  createdAt   DateTime     @default(now())
  building    Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
}
